#    status - Byobu's status layout overrides.
#
#      Overrides the defaults shipped with byobu. The layout below keeps
#      only what earns its place on the bar; everything else byobu offers
#      is intentionally absent because it re-reads /proc or shells out
#      on every refresh for values that do not need to be watched.

# Modules kept:
#   session             name of the current tmux session (native)
#   updates_available   count of packages with an upgrade pending; the
#                       value is cached and recomputed only when the
#                       package index changes, never on every refresh
#   date, time          local date and time
# The window list (index:name of each window) is native tmux and lives
# between the left and right blocks; see .tmux.conf.

# Every module NOT listed here was dropped on purpose. Worth naming one:
# ip_address. It calls `ifconfig <iface>`, and on Termux without root
# ifconfig cannot read /proc/net/dev, so it printed
# "Warning: cannot open /proc/net/dev (Permission denied). Limited output."
# to the terminal on every repaint. The rest (uptime, load_average,
# cpu_count, cpu_freq, memory, disk, swap, raid, reboot_required,
# entropy, fan_speed, battery, wifi_quality, processes, packages, mail,
# services, whoami, hostname, network, distro, release, arch, logo,
# users, apport, custom, menu, time_utc, time_binary) re-read files or
# fork commands on a fixed interval and bring no signal worth the noise.

# Screen layouts: unused; cleared so nothing is evaluated for them either.
screen_upper_left=""
screen_upper_right=""
screen_lower_left=""
screen_lower_right=""

# Tmux status line: one bar, two halves.
#   left   session name + pending updates
#   right  date + time
# The window list sits between them (native tmux, see profiles/tmux).
tmux_left="session updates_available"
tmux_right="date time"
