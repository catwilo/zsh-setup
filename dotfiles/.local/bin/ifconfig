#!/data/data/com.termux/files/usr/bin/sh
# ifconfig shim -- avoid toybox ifconfig's "cannot open /proc/net/dev"
# on Termux without root.
#
# Why this file exists: toybox ifconfig opens /proc/net/dev to enumerate
# interfaces. On Android, /proc/net/dev is not readable by unprivileged
# processes, so every call prints
#
#     Warning: cannot open /proc/net/dev (Permission denied). Limited output.
#
# to stderr. That is not censorship material -- it is a genuine warning
# the kernel is producing. But it fires on every byobu startup (byobu
# pre-computes ip_address even when the module is not shown on the bar),
# so the terminal accumulates one warning per session.
#
# The correct fix is to remove the cause: do not call toybox ifconfig in
# a context where it cannot do its job. When /proc/net/dev is readable
# (root, or a future Termux policy change), this shim execs the real
# ifconfig unchanged, so nothing is hidden.
#
# Placed at ~/.local/bin/ifconfig, which $HOME/.local/bin prepends to
# PATH (see .zshrc). The real binary at $PREFIX/bin/ifconfig is untouched.
if [ ! -r /proc/net/dev ]; then
    exit 1
fi
exec /data/data/com.termux/files/usr/bin/ifconfig "$@"
